# Back-office — variables publiques (incluses dans le code envoyé au navigateur).
# NE JAMAIS mettre ici la clé service_role.

# URL du projet Supabase (local : http://127.0.0.1:54321)
VITE_SUPABASE_URL=
# Clé publique « anon / publishable » (local : `supabase status`)
VITE_SUPABASE_ANON_KEY=
# Adresse du site public (aperçus des images img/… et liens « Voir sur le site »)
VITE_SITE_URL=
# Chemin où le back-office est servi. En production Vercel, le back-office
# est servi sur le même domaine sous /admin : tools/build-vercel.mjs règle
# cette valeur automatiquement — ne la définissez pas dans .env.
VITE_BASE=
